  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'sha256-Jovyjecf5nDAw9Mzaebeq0yUlXm/tsK3/yBxcAZOMzA=' 'sha256-Ia36KdZ2fVqnxjnOg776Jc7PUh6lX3uh5NfTejcmS5g=' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https:; connect-src 'self' https://static.cloudflareinsights.com https://cloudflareinsights.com https://*.supabase.co https://api.frankfurter.app https://generativelanguage.googleapis.com https://*.qdataline.com; frame-ancestors 'none'; base-uri 'self'
